{
  "name": "electric-sim-platform",
  "private": true,
  "version": "1.0.0",
  "description": "3D 电工电子虚拟仿真实训平台（Vue 3 + Vite + Three.js）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "teacher": "node server/create-teacher.mjs",
    "db:reset": "node server/reset-db.mjs",
    "db:smoke": "node server/smoke.mjs",
    "check:core": "node scripts/check-core.mjs",
    "check:components": "node scripts/check-components.mjs",
    "check:graph": "node scripts/check-graphmatch.mjs",
    "test:grading": "node scripts/tests/grading.test.mjs",
    "test:records": "node scripts/tests/records.test.mjs",
    "test:analysis": "node scripts/tests/analysis.test.mjs",
    "test:led": "node scripts/tests/led-experiment.test.mjs",
    "test:iso": "node scripts/tests/isomorphism.test.mjs",
    "test:tier": "node scripts/tests/tiered-grade.test.mjs",
    "test:http": "node scripts/tests/records-http.test.mjs && node scripts/tests/analyze-http.test.mjs",
    "validate:grading": "node scripts/validate/grading-accuracy.mjs",
    "check": "node scripts/check-core.mjs && node scripts/check-components.mjs && node scripts/check-graphmatch.mjs && node scripts/tests/grading.test.mjs && node scripts/tests/analysis.test.mjs && node scripts/tests/led-experiment.test.mjs && node scripts/tests/isomorphism.test.mjs && node scripts/tests/tiered-grade.test.mjs && node scripts/validate/grading-accuracy.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "js-yaml": "^5.5.0",
    "three": "^0.160.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.2.11"
  }
}
