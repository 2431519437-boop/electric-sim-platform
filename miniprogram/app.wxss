page {
  --bg: #0b1524;
  --panel: #101f33;
  --panel2: #16283f;
  --line: rgba(125, 211, 252, 0.18);
  --text: #dbeafe;
  --muted: #8fb0d1;
  --accent: #38bdf8;
  --ok: #22c55e;
  --warn: #f59e0b;
  --err: #ef4444;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.card {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #bae6fd;
  margin-bottom: 18rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.row .k {
  color: var(--muted);
  font-size: 26rpx;
}

.row .v {
  font-size: 30rpx;
  font-weight: 700;
  color: #e2f3ff;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #bae6fd;
  background: rgba(56, 189, 248, 0.16);
  border: 1rpx solid rgba(125, 211, 252, 0.32);
  margin-top: 20rpx;
}

.btn.primary {
  background: linear-gradient(135deg, #0284c7, #38bdf8);
  color: #fff;
  border-color: transparent;
}

.btn.ghost {
  background: rgba(255, 255, 255, 0.08);
  color: #cbd5e1;
  border-color: rgba(255, 255, 255, 0.14);
}

.input {
  height: 84rpx;
  border-radius: 14rpx;
  background: #091627;
  border: 1rpx solid rgba(125, 211, 252, 0.25);
  color: #eaf3ff;
  padding: 0 22rpx;
  font-size: 28rpx;
  margin-bottom: 18rpx;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
}

.tag.ok {
  color: #bbf7d0;
  background: rgba(34, 197, 94, 0.18);
  border: 1rpx solid rgba(74, 222, 128, 0.35);
}

.tag.err {
  color: #fecaca;
  background: rgba(153, 27, 27, 0.5);
  border: 1rpx solid rgba(248, 113, 113, 0.4);
}
