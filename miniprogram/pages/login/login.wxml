<view class="page">
  <view class="hero">
    <view class="logo">⚡</view>
    <view class="h1">3D 电工电子虚拟仿真实训平台</view>
    <view class="h2">小程序端 · 串联分压实验</view>
  </view>

  <view class="card">
    <view class="card-title">{{ mode === 'login' ? '登录' : '注册新账号' }}</view>

    <input
      class="input"
      placeholder="用户名（3-20 位字母/数字/下划线）"
      placeholder-class="ph"
      data-key="username"
      value="{{username}}"
      bindinput="onInput"
    />

    <input
      wx:if="{{mode === 'register'}}"
      class="input"
      placeholder="显示名（如：张三）"
      placeholder-class="ph"
      data-key="displayName"
      value="{{displayName}}"
      bindinput="onInput"
    />

    <input
      class="input"
      password
      placeholder="密码（至少 6 位）"
      placeholder-class="ph"
      data-key="password"
      value="{{password}}"
      bindinput="onInput"
    />

    <view wx:if="{{error}}" class="error">{{error}}</view>

    <button class="btn primary" loading="{{loading}}" bindtap="submit">
      {{ mode === 'login' ? '登录' : '注册并登录' }}
    </button>

    <view class="switch" bindtap="switchMode">
      {{ mode === 'login' ? '没有账号？去注册' : '已有账号？去登录' }}
    </view>

    <view class="switch guest" bindtap="guest">游客体验（数据不存档）</view>
  </view>

  <view class="foot">
    <view class="muted">服务器：{{base}}</view>
    <view class="muted">开发调试请勾选「不校验合法域名」</view>
  </view>
</view>
