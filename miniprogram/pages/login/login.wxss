.hero {
  padding: 40rpx 8rpx 30rpx;
}
.logo {
  font-size: 64rpx;
  line-height: 1;
  margin-bottom: 14rpx;
}
.h1 {
  font-size: 36rpx;
  font-weight: 800;
  color: #e2f3ff;
}
.h2 {
  font-size: 24rpx;
  color: #8fb0d1;
  margin-top: 8rpx;
}

.ph {
  color: #4b6784;
}

.error {
  color: #fca5a5;
  font-size: 24rpx;
  background: rgba(120, 24, 24, 0.45);
  border: 1rpx solid rgba(248, 113, 113, 0.35);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 16rpx;
}

.switch {
  text-align: center;
  color: #7dd3fc;
  font-size: 26rpx;
  padding: 18rpx 0 0;
}

.switch.guest {
  color: #8fb0d1;
  font-size: 24rpx;
  padding-top: 12rpx;
}

.foot {
  text-align: center;
  padding: 10rpx 0 30rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #bae6fd;
  background: rgba(56, 189, 248, 0.16);
  border: 1rpx solid rgba(125, 211, 252, 0.32);
  margin-top: 20rpx;
}

.btn.primary {
  background: linear-gradient(135deg, #0284c7, #38bdf8);
  color: #fff;
  border-color: transparent;
}
