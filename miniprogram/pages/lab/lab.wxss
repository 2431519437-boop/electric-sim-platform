.topbar {
  display: flex;
  align-items: center;
  padding: 6rpx 4rpx 22rpx;
}
.brand {
  font-size: 32rpx;
  font-weight: 800;
  color: #e2f3ff;
}
.sp {
  flex: 1;
}
.chip {
  font-size: 24rpx;
  color: #e2f3ff;
  background: rgba(16, 45, 74, 0.9);
  border: 1rpx solid rgba(125, 211, 252, 0.3);
  border-radius: 40rpx;
  padding: 8rpx 20rpx;
}
.chip.guest {
  color: #8fb0d1;
}
.chip .role {
  font-size: 20rpx;
  color: #bae6fd;
  background: rgba(56, 189, 248, 0.2);
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
}

.cv {
  width: 100%;
  height: 400rpx;
  margin: 4rpx 0 12rpx;
  background: #0a1626;
  border-radius: 14rpx;
}

.slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.slider {
  flex: 1;
}
.val {
  width: 150rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
  color: #bae6fd;
}

.theory {
  font-size: 24rpx;
  color: #8fb0d1;
  margin: 12rpx 0 6rpx;
}

.clear {
  float: right;
  font-size: 22rpx;
  font-weight: 400;
  color: #f87171;
}

.rec {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #0e1e33;
  border: 1rpx solid rgba(125, 211, 252, 0.1);
  margin-bottom: 10rpx;
  font-size: 26rpx;
}
.rec-n {
  color: #55708e;
  width: 60rpx;
}
.rec-r2 {
  color: #fbcfe8;
  width: 130rpx;
}
.rec-u {
  color: #bae6fd;
  flex: 1;
}
.rec-i {
  color: #6ee7a8;
}

.foot {
  text-align: center;
  padding: 10rpx 0 40rpx;
}
