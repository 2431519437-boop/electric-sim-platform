# 依赖
node_modules/

# 构建产物
dist/
dist-ssr/

# 本地缓存 / 临时验证产物
.npm-cache/
.cache/
.tmp/
.tmp-build/
.verify/
.backup/

# 项目工作日志（WorkBuddy 本地记忆，不进入版本库）
.workbuddy/

# 实验数据（本地 SQLite，含 WAL/SHM）
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

# 发布产物中的大二进制（文档仍进版本库）
发布/*.apk
发布/*.tar.gz
发布/*.zip

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器 / 系统
.DS_Store
Thumbs.db
*.local
