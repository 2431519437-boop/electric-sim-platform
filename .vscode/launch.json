{
  // VS Code 调试配置：F5 可以选下面任意一个
  // 1) 「后端服务」      -> 用 Node 24 直接启动 server/index.js（不依赖系统 PATH 里的 node）
  // 2) 「浏览器打开平台」 -> 用本机 Edge 打开 http://127.0.0.1:3001
  // 3) 「平台（后端+浏览器）」-> 两者一起起（推荐）
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "后端服务",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}",
      // 你机器上系统 PATH 里的 node 已失效，这里写死可用的 Node 24
      "runtimeExecutable": "D:\\hclaw\\node\\node.exe",
      "runtimeArgs": ["--no-warnings"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "浏览器打开平台",
      "url": "http://127.0.0.1:3001",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe"
    }
  ],
  "compounds": [
    {
      "name": "平台（后端+浏览器）",
      "configurations": ["后端服务", "浏览器打开平台"],
      "stopAll": true
    }
  ]
}
